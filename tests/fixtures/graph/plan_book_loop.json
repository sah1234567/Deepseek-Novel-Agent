{
  "version": "1",
  "enforce_gates": true,
  "max_parallel_nodes": 4,
  "auto_start_ready": false,
  "settings": { "targetChapters": 200 },
  "loops": [
    {
      "id": "book-body",
      "stations": ["ensure-fine-outline", "write-chapter", "sync-canon"],
      "entry": "ensure-fine-outline",
      "advance_after": "sync-canon",
      "cursor": { "counters": { "chapter": 1, "volume": 1, "round": 1 } },
      "advance": { "increment": "chapter", "step": 1, "side_effects": [{ "op": "increment", "counter": "round", "by": 1 }] },
      "until": { "type": "counter_gt", "counter": "chapter", "value_from": "work_meta.settings.targetChapters" },
      "on_advance": {
        "reopen": ["ensure-fine-outline", "write-chapter", "sync-canon"],
        "clear_node_sessions": true,
        "reinject_objectives": true,
        "preserve_canon_files": true
      },
      "world_state_board": ["knowledge/characters/", "knowledge/INDEX.md"]
    }
  ],
  "nodes": [
    {
      "id": "world-bible", "title": "世界观", "spec": "build world bible", "tags": ["world_bible"],
      "artifacts": [{ "path": "knowledge/shared-systems/背景设定.md", "role": "primary_deliverable" }],
      "acceptance": { "human": { "required": true, "on_reject": "continue", "prompt": "批准世界观？" } }
    },
    {
      "id": "outline", "title": "大纲", "spec": "write outline", "deps": ["world-bible"], "tags": ["outline"],
      "artifacts": [{ "path": "knowledge/plot/大纲.md", "role": "primary_deliverable" }],
      "acceptance": { "machine": "auditor", "human": { "required": true, "on_reject": "continue", "prompt": "批准大纲？" } }
    },
    {
      "id": "ensure-fine-outline", "title": "细纲", "spec_template": "fine outline ch{{cursor.chapter}}", "deps": ["outline"], "tags": ["ensure_fine_outline"],
      "artifacts": [{ "path_template": "knowledge/plot/细纲/chapter-{{cursor.chapter | pad3}}-细纲.md", "role": "primary_deliverable" }],
      "acceptance": { "machine": "auditor" }
    },
    {
      "id": "write-chapter", "title": "写章", "spec_template": "write chapter {{cursor.chapter}}", "deps": ["ensure-fine-outline"], "tags": ["chapter_body"],
      "artifacts": [{ "path_template": "chapters/chapter-{{cursor.chapter | pad3}}.md", "role": "primary_deliverable" }],
      "iterate": { "max_iterations": 8, "until": "auditor_pass" }
    },
    {
      "id": "sync-canon", "title": "正典", "spec_template": "sync canon ch{{cursor.chapter}}", "deps": ["write-chapter"], "tags": ["sync_canon"],
      "artifacts": [{ "path": "knowledge/characters/", "role": "aux" }, { "path": "knowledge/INDEX.md", "role": "aux" }]
    },
    {
      "id": "volume-review", "title": "卷审", "spec": "volume review", "deps": ["sync-canon"], "tags": ["volume_review"]
    }
  ]
}
