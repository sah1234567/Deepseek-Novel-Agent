{
  "version": "1",
  "enforce_gates": true,
  "max_parallel_nodes": 4,
  "auto_start_ready": false,
  "target_chapters": 200,
  "loops": [
    {
      "id": "book-body",
      "stations": ["ensure-fine-outline", "write-chapter", "sync-canon"],
      "entry": "ensure-fine-outline",
      "advance_after": "sync-canon",
      "cursor": { "chapter": 1, "volume": 1, "fine_outline_through": 0, "round": 1 },
      "until": { "op": "chapter_gt", "value_from": "work_meta.target_chapters" },
      "on_advance": {
        "reopen": ["ensure-fine-outline", "write-chapter", "sync-canon"],
        "clear_node_sessions": true,
        "reinject_objectives": true,
        "preserve_canon_files": true
      },
      "world_state_board": [
        "knowledge/characters/",
        "knowledge/shared-systems/",
        "knowledge/plot/伏笔追踪.md",
        "knowledge/plot/因果链.md",
        "knowledge/shared-systems/时间线.md",
        "knowledge/INDEX.md"
      ]
    }
  ],
  "nodes": [
    {
      "id": "world-bible",
      "title": "世界观与人物圣经",
      "spec": "建立世界观、力量体系与主要人物设定，写入 knowledge/ 对应文件。Observable: 背景设定与至少一名主角人物卡存在。",
      "kind": "world_bible",
      "deps": [],
      "artifacts": [
        { "path": "knowledge/shared-systems/背景设定.md", "role": "primary_deliverable" },
        { "path": "knowledge/characters/", "role": "aux" }
      ],
      "acceptance": {
        "machine": "none",
        "human": { "required": true, "on_reject": "continue", "prompt": "批准世界观与人物设定？" }
      }
    },
    {
      "id": "outline",
      "title": "总大纲",
      "spec": "基于已批准圣经撰写 knowledge/plot/大纲.md（四要素完整）。",
      "kind": "outline",
      "deps": ["world-bible"],
      "artifacts": [
        { "path": "knowledge/plot/大纲.md", "role": "primary_deliverable" }
      ],
      "acceptance": {
        "machine": "auditor",
        "human": { "required": true, "on_reject": "continue", "prompt": "批准总大纲？" }
      }
    },
    {
      "id": "ensure-fine-outline",
      "title": "确保当前章细纲",
      "spec_template": "确认第 {{cursor.chapter}} 章细纲存在且可用；缺失则补写 knowledge/plot/细纲/ 下对应文件并更新追踪表。",
      "kind": "ensure_fine_outline",
      "deps": ["outline"],
      "artifacts": [
        { "path_template": "knowledge/plot/细纲/chapter-{{cursor.chapter | pad3}}-细纲.md", "role": "primary_deliverable" }
      ],
      "acceptance": {
        "machine": "auditor",
        "human": { "required": false, "on_reject": "continue" }
      }
    },
    {
      "id": "write-chapter",
      "title": "撰写当前章",
      "spec_template": "根据细纲撰写第 {{cursor.chapter}} 章正文（2000–4000字）。读正典板最新状态；写完后不要擅自改未声明路径。",
      "kind": "chapter_body",
      "deps": ["ensure-fine-outline"],
      "artifacts": [
        { "path_template": "chapters/chapter-{{cursor.chapter | pad3}}.md", "role": "primary_deliverable" }
      ],
      "acceptance": {
        "machine": "auditor",
        "human": { "required": false, "on_reject": "continue" }
      },
      "iterate": { "max_iterations": 8, "until": "auditor_pass" }
    },
    {
      "id": "sync-canon",
      "title": "同步正典板",
      "spec_template": "根据第 {{cursor.chapter}} 章正文与 handoff，更新人物/场景/伏笔/因果/时间线/INDEX，使正典板反映最新状态。",
      "kind": "sync_canon",
      "deps": ["write-chapter"],
      "artifacts": [
        { "path": "knowledge/characters/", "role": "aux" },
        { "path": "knowledge/plot/伏笔追踪.md", "role": "aux" },
        { "path": "knowledge/plot/因果链.md", "role": "aux" },
        { "path": "knowledge/INDEX.md", "role": "aux" }
      ],
      "acceptance": {
        "machine": "none",
        "human": { "required": false, "on_reject": "continue" }
      }
    },
    {
      "id": "volume-review",
      "title": "卷末统稿",
      "spec": "在 book-body loop 完成后进行卷级回顾与质量检查。",
      "kind": "volume_review",
      "deps": ["sync-canon"],
      "artifacts": [
        { "path": "knowledge/meta/volume-review.md", "role": "primary_deliverable" }
      ],
      "acceptance": {
        "machine": "none",
        "human": { "required": true, "on_reject": "continue", "prompt": "批准本卷统稿？" }
      }
    }
  ]
}
